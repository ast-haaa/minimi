# Minimi - AI Chat Agent API Keys
# Copy this to .env and fill in your values

# Required: OpenAI API key for the language model
OPENAI_API_KEY=your_openai_api_key_here

# Required: Tavily API key for web search
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Path to SQLite database file (default: ./data/minimi.db)
DATABASE_PATH=./data/minimi.db

# Optional: Server port (default: 3001)
PORT=3001

# Optional: Timezone for date display (default: UTC)
APP_TIMEZONE=UTC

