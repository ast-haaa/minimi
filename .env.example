# Minimi - AI Research Agent Environment Configuration
# Copy this file to .env and fill in your keys

# AI Provider: 'groq' or 'openai' (default: groq)
AI_PROVIDER=groq

# Groq API Configuration (required when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-120b

# OpenAI API Configuration (required when AI_PROVIDER=openai, optional otherwise)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o

# Tavily Web Search API (required for live web research & verification)
TAVILY_API_KEY=your_tavily_api_key

# SQLite Database storage location
DATABASE_PATH=./data/minimi.db

# Server Port
PORT=3001

# User Timezone for relative date resolution (e.g. Asia/Kolkata, America/New_York, UTC)
APP_TIMEZONE=Asia/Kolkata
